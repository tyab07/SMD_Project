<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campus Societies"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <!-- Search Bar for Societies -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchViewSocieties"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:iconifiedByDefault="false"
                app:queryHint="Search society events..." />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Top section for Societies -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Societies to Follow"
        android:textColor="#333333"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingHorizontal="20dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSocietiesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="8dp" />

    <!-- Announcements Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Announcements &amp; Events"
        android:textColor="#333333"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingHorizontal="20dp" />

    <!-- Societies Events RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSocieties"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Tap an event for details and registration forms."
        android:textColor="#757575"
        android:textSize="14sp" />

</LinearLayout>
