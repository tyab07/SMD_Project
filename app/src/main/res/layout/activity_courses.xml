<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Scrollable content area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Registered Courses"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="20dp"
                android:textColor="#333333"/>

            <!-- INCLUSION: This brings in your TableLayout (Requirement L7) -->
            <include layout="@layout/layout_course_table" />

            <!-- Additional info can go here -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="Note: Attendance below 75% will result in a FA grade."
                android:textColor="#E53935"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Navigation Tabs Container -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- INCLUSION: This brings in your Navigation Tabs -->
        <include layout="@layout/layout_bottom_tabs" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>